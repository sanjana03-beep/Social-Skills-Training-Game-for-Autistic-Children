# Server Configuration
PORT=5000

# MongoDB Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/socialsteps?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Google Cloud Text-to-Speech Configuration
# Option 1: Google Cloud API Key (simplest setup)
GOOGLE_TTS_API_KEY=

# Option 2: Path to your Google Cloud service account JSON key file (e.g. backend/google-credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=

# Voice Settings (Tuned for educational social-skills learning for autistic children)
# Default language: en-US
GOOGLE_TTS_LANGUAGE_CODE=en-US

# Recommended voices:
# - en-US-Neural2-F (Clear, gentle, natural female voice)
# - en-US-Journey-F (Very expressive, friendly storytelling voice)
# - en-US-Standard-C (Standard alternative)
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-F

# Speaking rate: 0.92 provides a calm, relaxed, and comprehensible pace
GOOGLE_TTS_SPEAKING_RATE=0.92

# Pitch adjustment: 0.0 (natural pitch)
GOOGLE_TTS_PITCH=0.0
